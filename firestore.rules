rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra base: usuário autenticado só acessa seus próprios dados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Sub-coleção de logs: mesmo controle por UID
      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sub-coleção de gastos: mesmo controle por UID
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /ampoules/{ampouleDocId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
